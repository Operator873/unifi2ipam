# UniFi Network Controller
# API key generated in the UniFi dashboard.
# Settings → Control Plane → Integrations → Create API Key
UNIFI_API_KEY=your_unifi_api_key_here

# Optional: set the controller URL here instead of in config.yaml
# UNIFI_URL=https://unifi.local/proxy/network/integration/v1/

# phpIPAM
# App code (token) generated alongside the App ID.
# Administration → API → Create API key
IPAM_API_KEY=your_ipam_api_key_here

# Optional: set phpIPAM connection details here instead of in config.yaml
# IPAM_BASE_URL=https://ipam.local
# IPAM_APP_ID=your_app_id
